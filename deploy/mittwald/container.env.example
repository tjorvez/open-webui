# Vorlage fuer die Umgebungsvariablen im mStudio-Container.
# Ersetze Domain, Admin-Daten und alle CHANGE_ME-Werte vor dem Start.
# Kopiere denselben mittwald-AI-Key in alle vier API-Key-Felder.
# Trage die Werte direkt im mStudio ein; es gibt keine Variablen-Interpolation.

HOME=/tmp/open-webui/home
STATIC_DIR=/tmp/open-webui/static
PYTHONDONTWRITEBYTECODE=1
WEBUI_URL=https://chat-test.example.de
CORS_ALLOW_ORIGIN=https://chat-test.example.de
WEBUI_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEBUI_ADMIN_EMAIL=admin@example.de
WEBUI_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
WEBUI_AUTH=true
WEBUI_SESSION_COOKIE_SECURE=true
ENABLE_SIGNUP=false
ENABLE_PERSISTENT_CONFIG=false
ENABLE_DIRECT_CONNECTIONS=false
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://llm.aihosting.mittwald.de/v1
OPENAI_API_BASE_URLS=https://llm.aihosting.mittwald.de/v1
OPENAI_API_KEY=CHANGE_ME_MITTWALD_AI_API_KEY
OPENAI_API_KEYS=CHANGE_ME_MITTWALD_AI_API_KEY
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=Qwen3-Embedding-8B
RAG_OPENAI_API_BASE_URL=https://llm.aihosting.mittwald.de/v1
RAG_OPENAI_API_KEY=CHANGE_ME_MITTWALD_AI_API_KEY
AUDIO_STT_ENGINE=openai
AUDIO_STT_MODEL=whisper-large-v3-turbo
AUDIO_STT_OPENAI_API_BASE_URL=https://llm.aihosting.mittwald.de/v1
AUDIO_STT_OPENAI_API_KEY=CHANGE_ME_MITTWALD_AI_API_KEY
ENABLE_IMAGE_GENERATION=false
UVICORN_WORKERS=1
HF_HUB_OFFLINE=1
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
