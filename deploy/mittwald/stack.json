{
  "services": {
    "open-webui": {
      "image": "${IMAGE_REF}",
      "description": "Open WebUI Fork mit mittwald AI Hosting",
      "command": ["bash", "start-mittwald.sh"],
      "ports": ["8080/tcp"],
      "envs": {
        "HOME": "/tmp/open-webui/home",
        "STATIC_DIR": "/tmp/open-webui/static",
        "PYTHONDONTWRITEBYTECODE": "1",
        "WEBUI_URL": "${WEBUI_URL}",
        "CORS_ALLOW_ORIGIN": "${WEBUI_URL}",
        "WEBUI_SECRET_KEY": "${WEBUI_SECRET_KEY}",
        "WEBUI_ADMIN_EMAIL": "${WEBUI_ADMIN_EMAIL}",
        "WEBUI_ADMIN_PASSWORD": "${WEBUI_ADMIN_PASSWORD}",
        "WEBUI_AUTH": "true",
        "WEBUI_SESSION_COOKIE_SECURE": "true",
        "ENABLE_SIGNUP": "false",
        "ENABLE_PERSISTENT_CONFIG": "false",
        "ENABLE_DIRECT_CONNECTIONS": "false",
        "ENABLE_OLLAMA_API": "false",
        "ENABLE_OPENAI_API": "true",
        "OPENAI_API_BASE_URL": "https://llm.aihosting.mittwald.de/v1",
        "OPENAI_API_BASE_URLS": "https://llm.aihosting.mittwald.de/v1",
        "OPENAI_API_KEY": "${MITTWALD_AI_API_KEY}",
        "OPENAI_API_KEYS": "${MITTWALD_AI_API_KEY}",
        "RAG_EMBEDDING_ENGINE": "openai",
        "RAG_EMBEDDING_MODEL": "Qwen3-Embedding-8B",
        "RAG_OPENAI_API_BASE_URL": "https://llm.aihosting.mittwald.de/v1",
        "RAG_OPENAI_API_KEY": "${MITTWALD_AI_API_KEY}",
        "AUDIO_STT_ENGINE": "openai",
        "AUDIO_STT_MODEL": "whisper-large-v3-turbo",
        "AUDIO_STT_OPENAI_API_BASE_URL": "https://llm.aihosting.mittwald.de/v1",
        "AUDIO_STT_OPENAI_API_KEY": "${MITTWALD_AI_API_KEY}",
        "ENABLE_IMAGE_GENERATION": "false",
        "UVICORN_WORKERS": "1",
        "HF_HUB_OFFLINE": "1",
        "SCARF_NO_ANALYTICS": "true",
        "DO_NOT_TRACK": "true",
        "ANONYMIZED_TELEMETRY": "false"
      },
      "volumes": [
        "open-webui-data:/app/backend/data",
        "open-webui-runtime:/tmp"
      ],
      "deploy": {
        "resources": {
          "limits": {"cpus": "2", "memory": "4g"}
        }
      }
    }
  },
  "volumes": {
    "open-webui-data": {"name": "open-webui-data"},
    "open-webui-runtime": {"name": "open-webui-runtime"}
  }
}
